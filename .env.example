# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# Public hostname players join (plus wildcard DNS *.domain, see the vecta README).
VECTA_DOMAIN=play.example.com
# HMAC key for route cookies. Keep it stable across restarts.
VECTA_COOKIE_SECRET=
# Bearer token for the gateway's /metrics (empty: open).
VECTA_METRICS_TOKEN=
# Owner token Crafty registers its servers with.
VECTA_CRAFTY_TOKEN=

TZ=Etc/UTC

# Published ports.
PANEL_PORT=8443
MC_PORT=25565
API_PORT=8080
# Public ports the gateway assigns to Simple Voice Chat and other side ports
# (TCP and UDP). Players reach them at VECTA_DOMAIN, or at VECTA_SIDEPORT_HOST
# when the domain points at a proxy that can't forward a port range.
VECTA_SIDEPORT_RANGE=24500-24599
# VECTA_SIDEPORT_HOST=voice.example.com

# Optional:
# Public URL of the gateway's server list (its API host), linked from the panel's vecta badge.
# VECTA_PUBLIC_URL=https://mc-api.example.com
# First MOTD line of the gateway.
# VECTA_MOTD=Join to pick a server
# Internal ports autoports hands to servers.
# VECTA_PORT_RANGE=25500-25999
# Simple Voice Chat through vecta, and the internal UDP ports it gets.
# VECTA_VOICE_CHAT=true
# VECTA_VOICE_PORT_RANGE=24000-24499
# CRAFTY_VERSION=4.10.8
# Build vecta from a local checkout instead of GitHub.
# VECTA_SRC=../vecta
# Change both if the subnet is already in use on this host.
# BACKEND_SUBNET=172.31.66.0/24
# CRAFTY_IP=172.31.66.10
# Gateway on another host (see README).
# VECTA_GATEWAY=https://mc-api.example.com
# VECTA_BACKEND_HOST=10.0.0.20
