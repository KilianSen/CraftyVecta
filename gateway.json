{
  "listen": ":25565",
  "apiListen": ":8080",
  "domain": "${VECTA_DOMAIN}",
  "cookieSecret": "${VECTA_COOKIE_SECRET}",
  "acceptProxyProtocol": false,
  "registrationTTL": "45s",
  "healthInterval": "10s",
  "pendingTTL": "5m",
  "motd": "${VECTA_MOTD:-Join to pick a server}",

  "dataFile": "/data/state.json",
  "stickyTTL": "720h",
  "maxLobbySessions": 500,
  "metricsToken": "${VECTA_METRICS_TOKEN}",

  "owners": {
    "crafty": {
      "token": "${VECTA_CRAFTY_TOKEN}",
      "allowedNetworks": ["${CRAFTY_IP:-172.31.66.10}/32"]
    }
  },
  "servers": []
}
